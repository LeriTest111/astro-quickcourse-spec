---
import ShowcaseLayout from "../layouts/ShowcaseLayout.astro";
import ShowcasePageHeader from "../components/showcase/ShowcasePageHeader.astro";
import { showcaseCategories } from "../data/showcase";
import { getShowcaseItemsForView } from "../data/showcase-registry";
import type { ShowcaseCategory as RegisteredShowcaseCategory } from "../data/showcase-registry";

const baseDescription =
  "Use this Showcase to review the building blocks for fast, single-page Quick Courses. In the Showcase, the navbar links open separate category pages to make review, governance and maintenance easier. In production Quick Courses, the same navigation pattern will link to topics and section anchors within the single course page.";
const categoryCards = showcaseCategories.map((category) => ({
  ...category,
  developmentItemCount: getShowcaseItemsForView(category.slug as RegisteredShowcaseCategory, "development").length,
  statuses: getShowcaseItemsForView(category.slug as RegisteredShowcaseCategory, "development")
    .concat(getShowcaseItemsForView(category.slug as RegisteredShowcaseCategory, "approved"))
    .map((item) => item.status),
}));
const visibleCountLabel = (count: number) => `${count} ${count === 1 ? "item" : "items"} in this view`;
---

<ShowcaseLayout
  pageTitle="Quick Course Kit"
  description="A concise index for reviewing reusable Quick Course component categories."
  activeCategory="home"
>
  <ShowcasePageHeader title="Quick Course Kit" description={baseDescription} />

  <p class="showcase-home-view-intro">Browse components currently in development or switch to the approved collection.</p>

  <section class="showcase-landing-grid mt-8" aria-label="Showcase categories">
    {categoryCards.map((category) => (
      <a
        class="showcase-category-card"
        href={category.href}
        data-showcase-view-link
        data-showcase-category-card
        data-showcase-category-statuses={category.statuses.join(",")}
      >
        <div>
          <h2>{category.label}</h2>
          <p>{category.description}</p>
          <p class="showcase-category-card__mode-note" data-showcase-category-count>
            {category.developmentItemCount > 0
              ? visibleCountLabel(category.developmentItemCount)
              : "No components in this category have been approved yet."}
          </p>
        </div>
        <div class="showcase-category-card__footer">
          <span class="material-symbols-sharp showcase-icon" aria-hidden="true">arrow_forward</span>
        </div>
      </a>
    ))}
  </section>

  <section class="showcase-workflow-link" aria-labelledby="workflow-link-heading">
    <div>
      <h2 id="workflow-link-heading">Need to understand the process?</h2>
      <p>
        See how ideas move from early concepts to signed-off Quick Course components and how the two collection views work.
      </p>
    </div>
    <a href="/showcase/workflow/" data-showcase-view-link>
      <span class="material-symbols-sharp showcase-icon" aria-hidden="true">account_tree</span>
      How the Quick Course Kit works
    </a>
  </section>
</ShowcaseLayout>
