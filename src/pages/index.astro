---
import ShowcaseLayout from "../layouts/ShowcaseLayout.astro";
import ShowcasePageHeader from "../components/showcase/ShowcasePageHeader.astro";
import { showcaseCategories } from "../data/showcase";
import { getVisibleShowcaseItems, showcaseMode, showcaseModeIdentity } from "../data/showcase-registry";
import type { ShowcaseCategory as RegisteredShowcaseCategory } from "../data/showcase-registry";

const modeIdentity = showcaseModeIdentity[showcaseMode];
const baseDescription =
  "Use this Showcase to review the building blocks for fast, single-page Quick Courses. In the Showcase, the navbar links open separate category pages to make review, governance and maintenance easier. In production Quick Courses, the same navigation pattern will link to topics and section anchors within the single course page.";
const workingDescription =
  "The Working Showcase includes proposed ideas, early concepts, draft components and items under review. Only signed-off components appear in the Approved Quick Course Kit.";
const pageDescription = showcaseMode === "working" ? `${baseDescription} ${workingDescription}` : baseDescription;
const categoryCards = showcaseCategories.map((category) => ({
  ...category,
  visibleItemCount: getVisibleShowcaseItems(category.slug as RegisteredShowcaseCategory).length,
}));
const visibleCountLabel = (count: number) => `${count} ${count === 1 ? "item" : "items"} visible in this mode`;
---

<ShowcaseLayout
  pageTitle="Astro Quick Course Showcase"
  description="A concise index for reviewing reusable Quick Course component categories."
  activeCategory="home"
>
  <ShowcasePageHeader
    title={modeIdentity.title}
    description={pageDescription}
  />

  <section class="showcase-landing-grid mt-8" aria-label="Showcase categories">
    {categoryCards.map((category) => (
      <a class="showcase-category-card" href={category.href}>
        <div>
          <h2>{category.label}</h2>
          <p>{category.description}</p>
          <p class="showcase-category-card__mode-note">
            {category.visibleItemCount > 0 ? visibleCountLabel(category.visibleItemCount) : "No approved items yet"}
          </p>
        </div>
        <div class="showcase-category-card__footer">
          <span class="material-symbols-sharp showcase-icon" aria-hidden="true">arrow_forward</span>
        </div>
      </a>
    ))}
  </section>

  <section class="showcase-workflow-link" aria-labelledby="workflow-link-heading">
    <div>
      <h2 id="workflow-link-heading">Need to understand the process?</h2>
      <p>
        See how ideas move from early concepts to signed-off Quick Course components, and how the Working Showcase
        differs from the Approved Kit.
      </p>
    </div>
    <a href="/showcase/workflow/">
      <span class="material-symbols-sharp showcase-icon" aria-hidden="true">account_tree</span>
      How the Quick Course Kit works
    </a>
  </section>
</ShowcaseLayout>
