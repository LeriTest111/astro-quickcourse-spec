---
import ShowcaseLayout from "../../layouts/ShowcaseLayout.astro";
import ShowcasePageHeader from "../../components/showcase/ShowcasePageHeader.astro";
import ShowcaseExample from "../../components/showcase/ShowcaseExample.astro";
---

<ShowcaseLayout
  pageTitle="Multimedia | Astro Quick Course Showcase"
  description="Multimedia examples for Quick Courses."
  activeCategory="multimedia"
>
  <ShowcasePageHeader
    title="Multimedia"
    description="Responsive media treatments for future video, audio, image and embedded-media patterns."
  />

  <div class="showcase-example-stack mt-8">
    <ShowcaseExample id="video-lesson" title="Video lesson placeholder" purpose="Reserves the pattern space for captioned video with a text alternative.">
      <article class="rounded-box border border-base-300 bg-base-100 p-6">
        <span class="material-symbols-sharp showcase-icon text-3xl text-primary" aria-hidden="true">play_circle</span>
        <h2 class="mt-3 text-xl font-semibold">Video lesson</h2>
        <p class="mt-2 text-base-content/70">A responsive player pattern will live here, with captions and a text alternative.</p>
      </article>
    </ShowcaseExample>

    <ShowcaseExample id="audio-clip" title="Audio clip placeholder" purpose="Reserves the pattern space for audio with a transcript and clear controls.">
      <article class="rounded-box border border-base-300 bg-base-100 p-6">
        <span class="material-symbols-sharp showcase-icon text-3xl text-primary" aria-hidden="true">headphones</span>
        <h2 class="mt-3 text-xl font-semibold">Audio clip</h2>
        <p class="mt-2 text-base-content/70">Audio examples will include a transcript and clear playback controls.</p>
      </article>
    </ShowcaseExample>
  </div>
</ShowcaseLayout>
