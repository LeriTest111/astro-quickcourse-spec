---
import ShowcaseLayout from "../../layouts/ShowcaseLayout.astro";
import ShowcasePageHeader from "../../components/showcase/ShowcasePageHeader.astro";
import ShowcaseSection from "../../components/showcase/ShowcaseSection.astro";
import ShowcaseExample from "../../components/showcase/ShowcaseExample.astro";
import ShowcaseNotes from "../../components/showcase/ShowcaseNotes.astro";
import ShowcaseEmptyState from "../../components/showcase/ShowcaseEmptyState.astro";
import PreviewOptions from "../../components/showcase/PreviewOptions.astro";
import VideoSection from "../../components/multimedia/VideoSection.astro";
import VideoTranscript from "../../components/multimedia/VideoTranscript.astro";
import VideoChapters from "../../components/multimedia/VideoChapters.astro";
import { getVisibleShowcaseItems } from "../../data/showcase-registry";

const sampleVideo = "/media/showcase/big-buck-bunny-10s.mp4";
const samplePoster = "/images/showcase/video-poster.svg";
const hasVisibleItems = getVisibleShowcaseItems("multimedia").length > 0;
---

<ShowcaseLayout
  pageTitle="Multimedia | Astro Quick Course Showcase"
  description="Multimedia examples for Quick Courses."
  activeCategory="multimedia"
>
  <ShowcasePageHeader
    title="Multimedia"
    description="Responsive media treatments for video, audio, image and embedded-media patterns in single-page Quick Courses."
  />

  <div class="showcase-section-stack mt-10">
    {!hasVisibleItems && <ShowcaseEmptyState />}
    {hasVisibleItems && <ShowcaseSection id="video-patterns" title="Video" description="Native video patterns using local sample media. The Big Buck Bunny clip is demonstration media for player behaviour, not course content.">
      <div class="showcase-example-stack">
        <ShowcaseExample id="standard-video" title="Standard Video" purpose="Provides a simple responsive native video section for most Quick Courses.">
          <PreviewOptions
            targetId="standard-video-poster-preview"
            options={[
              {
                id: "poster-image",
                label: "Poster image",
                type: "segmented",
                value: "with",
                targetAttribute: "posterImage",
                options: [
                  { label: "With poster", value: "with" },
                  { label: "Without poster", value: "without" },
                ],
              },
            ]}
          />
          <div id="standard-video-poster-preview" data-showcase-video-poster-preview data-poster-src={samplePoster}>
            <VideoSection
              id="standard-sample-video"
              heading="Sample media player"
              intro="Use the native browser controls by default. Production videos should include accurate captions and a transcript."
              src={sampleVideo}
              poster={samplePoster}
              title="Big Buck Bunny sample video"
              caption="Sample MP4 used only to demonstrate local video playback."
            />
          </div>
          <ShowcaseNotes>
            <p>No autoplay, loop or custom player library is used. Use Standard Video for short introductions, brand messages and focused demonstrations where internal navigation is unnecessary.</p>
            <p>The shared player requests that browser menus hide Download and Picture-in-Picture, but native control support varies by browser. Playback speed and fullscreen remain browser-controlled.</p>
          </ShowcaseNotes>
        </ShowcaseExample>

        <ShowcaseExample id="video-with-transcript" title="Video with Transcript" purpose="Keeps a searchable text alternative available without playing the video.">
          <VideoTranscript
            id="transcript-sample-video"
            heading="Video with transcript excerpt"
            intro="This demonstrates transcript placement. It is not a full transcript of the sample film."
            src={sampleVideo}
            videoTitle="Big Buck Bunny sample video with transcript excerpt"
            caption="Sample MP4 used only to demonstrate transcript layout."
            transcriptHeading="Demonstration transcript excerpt"
            expandable={true}
            transcript={[
              "Demonstration media: A short animated sample clip is shown for testing the native video player and transcript layout.",
              "Production note: Replace this excerpt with an accurate transcript for the actual instructional video.",
            ]}
          />
          <ShowcaseNotes>
            <p>The transcript uses text in the page, so it remains available without playback and without JavaScript.</p>
          </ShowcaseNotes>
        </ShowcaseExample>

        <ShowcaseExample id="video-with-chapters" title="Video with Chapters" purpose="Lets learners jump to meaningful points in a longer instructional video without replacing native controls.">
          <PreviewOptions
            targetId="chaptered-video-poster-preview"
            options={[
              {
                id: "poster-image",
                label: "Poster image",
                type: "segmented",
                value: "with",
                targetAttribute: "posterImage",
                options: [
                  { label: "With poster", value: "with" },
                  { label: "Without poster", value: "without" },
                ],
              },
            ]}
          />
          <div id="chaptered-video-poster-preview" data-showcase-video-poster-preview data-poster-src={samplePoster}>
            <VideoChapters
              id="chaptered-sample-video"
              heading="Video with chapter buttons"
              intro="Chapter buttons seek within the local sample clip and leave normal playback controls available."
              src={sampleVideo}
              poster={samplePoster}
              videoTitle="Big Buck Bunny sample video with chapter buttons"
              caption="Sample MP4 used only to demonstrate chapter seeking."
              chapters={[
                { title: "Introduction", time: 0, description: "Start the short demonstration clip." },
                { title: "Preparing for the task", time: 1, description: "Review the opening context." },
                { title: "Reviewing the first step", time: 2, description: "Move to an early point in the sample." },
                { title: "Noticing the movement", time: 3, description: "Use a valid chapter point within the clip." },
                { title: "Checking the transition", time: 4, description: "Jump to the next visible change." },
                { title: "Common mistakes", time: 5, description: "Demonstrates compact chapter spacing." },
                { title: "Completing the process", time: 7, description: "Move near the end of the short clip." },
                { title: "Key takeaways", time: 9, description: "Review the final moment before the clip ends." },
              ]}
            />
          </div>
          <ShowcaseNotes>
            <p>Use chapters for longer instructional videos, procedural demonstrations and reference content learners may revisit. Three to seven meaningful chapters is usually enough unless the content genuinely needs more.</p>
            <p>Chapter titles should describe what learners will find. Chapters improve navigation, but they do not replace captions, transcripts or audio description where required.</p>
          </ShowcaseNotes>
        </ShowcaseExample>
      </div>
    </ShowcaseSection>}
  </div>
</ShowcaseLayout>

{
  hasVisibleItems && (
    <script is:inline>
      document.querySelectorAll("[data-showcase-video-poster-preview]").forEach((root) => {
        if (root.dataset.showcaseVideoPosterReady === "true") return;
        root.dataset.showcaseVideoPosterReady = "true";

        const video = root.querySelector("video");
        const posterSrc = root.dataset.posterSrc ?? video?.getAttribute("poster") ?? "";

        function applyPosterOption() {
          if (!(video instanceof HTMLVideoElement)) return;
          const shouldUsePoster = root.dataset.posterImage !== "without";

          if (shouldUsePoster && posterSrc) {
            video.setAttribute("poster", posterSrc);
          } else {
            video.removeAttribute("poster");
          }
        }

        root.addEventListener("showcase-options-change", applyPosterOption);
        applyPosterOption();
      });
    </script>
  )
}
