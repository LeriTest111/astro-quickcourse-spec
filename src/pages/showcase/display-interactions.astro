---
import ShowcaseLayout from "../../layouts/ShowcaseLayout.astro";
import ShowcasePageHeader from "../../components/showcase/ShowcasePageHeader.astro";
import ShowcaseAnchorNav from "../../components/showcase/ShowcaseAnchorNav.astro";
import ShowcaseSection from "../../components/showcase/ShowcaseSection.astro";
import ShowcaseExample from "../../components/showcase/ShowcaseExample.astro";
import ShowcaseNotes from "../../components/showcase/ShowcaseNotes.astro";
import ShowcaseEmptyState from "../../components/showcase/ShowcaseEmptyState.astro";
import ProposalCard from "../../components/showcase/ProposalCard.astro";
import PreviewOptions from "../../components/showcase/PreviewOptions.astro";
import Accordion from "../../components/interactions/display/Accordion.astro";
import Tabs from "../../components/interactions/display/Tabs.astro";
import FlipCards from "../../components/interactions/display/FlipCards.astro";
import Carousel from "../../components/interactions/display/Carousel.astro";
import HotspotReveal from "../../components/interactions/display/HotspotReveal.astro";
import Timeline from "../../components/interactions/display/Timeline.astro";
import ProcessExplorer from "../../components/interactions/display/ProcessExplorer.astro";
import ExpandableImage from "../../components/interactions/display/ExpandableImage.astro";
import DetailModal from "../../components/interactions/display/DetailModal.astro";
import type { FlipCardItem } from "../../components/interactions/display/flip-card-types";
import { displayInteractionAnchors } from "../../data/showcase";
import { getShowcaseItem, isShowcaseItemVisible } from "../../data/showcase-registry";

const neutralImage = "/images/showcase/hero-1.avif";
const flipCardPortraitImage = "/images/showcase/flip-card-retail-reference.png";
const flipCardWideImage = "/images/showcase/flip-card-display-wide.png";
const flipCardDetailImage = "/images/showcase/flip-card-product-detail.png";
const revealModeComparisonCards = [
  {
    front: {
      type: "image-overlay",
      image: flipCardWideImage,
      imageAlt: "An unbranded skincare counter with products in the foreground and a staff member arranging a shelf in the background.",
      eyebrow: "Product knowledge",
      title: "Make the product story clear.",
      body: "Use the display to support a focused conversation.",
      overlayStyle: "dark",
      alignment: "left",
      verticalAlignment: "center",
    },
    back: {
      type: "text",
      title: "Start with the customer need.",
      body: "Choose one relevant product benefit, explain it in plain language and confirm the next useful action.",
      alignment: "left",
      verticalAlignment: "top",
      surface: "neutral",
    },
  },
] satisfies FlipCardItem[];
const visible = (id: string) => isShowcaseItemVisible(id);
const status = (id: string) => getShowcaseItem(id)?.status;
const guidedProductExplorer = getShowcaseItem("guided-product-explorer");
const sectionItems = {
  "reveal-content": ["accordion", "flip-cards", "hotspot-reveal", "guided-product-explorer", "detail-modal"],
  "navigate-related-content": ["tabs", "carousel", "process-explorer", "timeline"],
  "explore-visual-content": ["expandable-image"],
};
const sectionVisible = (id: keyof typeof sectionItems) => sectionItems[id].some((itemId) => visible(itemId));
const visibleAnchors = displayInteractionAnchors.filter((anchor) => sectionVisible(anchor.href.slice(1) as keyof typeof sectionItems));
const hasVisibleItems = Object.keys(sectionItems).some((id) => sectionVisible(id as keyof typeof sectionItems));
---

<ShowcaseLayout
  pageTitle="Display Interactions | Astro Quick Course Showcase"
  description="Reusable display interaction examples for Quick Courses."
  activeCategory="display-interactions"
>
  <ShowcasePageHeader
    title="Display Interactions"
    description="Reusable patterns that help learners reveal, compare and move through information without scoring answers or sending assessment results."
  />

  {visibleAnchors.length > 0 && (
    <div class="mt-6">
      <ShowcaseAnchorNav items={visibleAnchors} />
    </div>
  )}

  <div class="showcase-section-stack mt-10">
    {!hasVisibleItems && <ShowcaseEmptyState />}

    {sectionVisible("reveal-content") && <ShowcaseSection id="reveal-content" title="Reveal content" description="Patterns for optional details, secondary layers and supporting context.">
      <div class="showcase-example-stack">
        {visible("accordion") && <ShowcaseExample id="accordion" title="Accordion" purpose="Reveals supporting answers without showing every detail at once." status={status("accordion")}>
          <Accordion
            id="customer-question-accordion"
            heading="Common customer questions"
            intro="Use accordions for optional explanations, not essential instructions that everyone must read."
            allowMultiple={false}
            defaultOpenIndex={0}
            items={[
              {
                title: "Why was I charged this amount?",
                content: "Start by confirming the date, service period and any fees shown on the account. Then explain the total in plain language.",
                icon: "receipt_long",
              },
              {
                title: "When will the payment reflect?",
                content: "Give the expected processing window and tell the customer where they can check the latest status.",
                icon: "schedule",
              },
              {
                title: "What happens if the payment fails?",
                content: "Explain the retry path, any notification they will receive and what action they can take to avoid delays.",
                icon: "error",
              },
            ]}
          />
          <ShowcaseNotes>
            <p>Avoid accordions when all content is required reading. In that case, keep the information visible in the main flow.</p>
          </ShowcaseNotes>
        </ShowcaseExample>}

        {visible("flip-cards") && <ShowcaseExample id="flip-cards" title="Quick Course Flip Card System" purpose="Controlled face layouts can be paired freely; reveal mode changes only how the reverse face appears." status={status("flip-cards")}>
          <div class="showcase-icon-information-controls">
            <DetailModal
              id="flip-card-usage-guidance"
              triggerLabel="Flip Card usage guidance"
              triggerIcon="information"
              triggerVariant="secondary"
              heading="Quick Course Flip Card usage guidance"
            >
              <p>Use one shared Flip Card System only when the reverse face creates a useful relationship, comparison or moment of discovery. Content determines the faces; reveal mode determines only how the reverse face appears.</p>
              <ul class="di-dialog__list">
                <li>Supported faces are Text, Icon-led, Image, Image Overlay, Feature and Statement. AI chooses controlled face content, semantic surface, horizontal alignment and vertical alignment independently for each face.</li>
                <li>Good uses include term and definition, myth and reality, image and explanation, feature and benefit, role and responsibility, a concise key fact or a short high-impact statement.</li>
                <li>Do not hide essential reading, long procedures, several paragraphs or formal assessment questions. Use an accordion, detail panel or visible process when content must remain available.</li>
                <li>Keep fronts concise and backs scannable. Use left and top alignment for explanatory content; use centre alignment and vertical centre for short icons, values and statements.</li>
                <li>Use meaningful alternative text for informative images. Do not nest links, buttons or controls inside a card, and do not use internal scrolling.</li>
                <li>Use semantic surfaces rather than arbitrary colours. Use status surfaces only where the content has that meaning, and keep foreground contrast controlled by the component.</li>
                <li>Use Flip as the default for two-sided concepts. Consider Slide for visual fronts, but every approved face layout works with either mode. Keep one reveal mode within a card set unless a designer directs otherwise.</li>
                <li>Use equal height for a matched grid and content height for independent or intentionally varied cards. Keep reveal mode, height mode and format consistent inside a card set.</li>
              </ul>
            </DetailModal>

            <DetailModal
              id="flip-card-technical-implementation"
              triggerLabel="Technical implementation"
              triggerIcon="settings"
              triggerVariant="secondary"
              heading="Quick Course Flip Card technical implementation"
            >
              <p>One shared Astro component receives structured Text, Icon-led, Image, Image Overlay, Feature or Statement faces. Shared base properties supply controlled surfaces and independent horizontal and vertical alignment.</p>
              <ul class="di-dialog__list">
                <li>Flip rotates a stable two-face stage using the semantic Flip indicator. Slide raises the back layer from the bottom using the controlled Expand and Collapse indicators. Both use the same button, keyboard and accessible-state handling.</li>
                <li>Content height measures the taller face of each card. Equal height measures every face in a group and aligns the group on wider screens; narrow layouts return to natural card heights.</li>
                <li>Semantic surfaces map to controlled foreground pairings, and Statement typography is component-controlled. Future theme tokens can replace these mapped values without changing the face API.</li>
                <li>Hidden faces are marked unavailable to assistive technology. The parent button updates its label and pressed state while decorative indicators remain hidden from assistive technology.</li>
                <li>Resize observation and image-load handling recalculate measured heights. Reduced-motion preference uses an instant face swap rather than rotation or a large slide.</li>
                <li>The component is static-site and SCORM compatible. Future theme tokens can supply surface, radius and brand-overlay values without changing the face API.</li>
              </ul>
            </DetailModal>
          </div>

          <section class="showcase-flip-card-section" aria-labelledby="flip-examples-heading">
            <h4 id="flip-examples-heading">Flip Card examples</h4>
            <FlipCards
              id="flip-card-examples"
              revealMode="flip"
              heightMode="equal"
              format="square"
              cards={[
                {
                  front: { type: "text", eyebrow: "Myth", title: "More detail always creates better help.", alignment: "center", verticalAlignment: "center", surface: "light" },
                  back: { type: "text", eyebrow: "Reality", title: "Start with the next useful action.", body: "Add only the context that helps the learner move forward.", alignment: "left", verticalAlignment: "top", surface: "neutral" },
                },
                {
                  front: { type: "icon", icon: "tip", iconTreatment: "feature", eyebrow: "Helpful tip", title: "Listen before solving.", body: "Let the person finish the concern first.", alignment: "center", verticalAlignment: "center", surface: "primary" },
                  back: { type: "text", title: "Why it works", body: "A clear understanding of the outcome avoids an answer that misses the real need.", verticalAlignment: "top", surface: "light" },
                },
                {
                  front: { type: "feature", value: "3", eyebrow: "Service habit", title: "Customer principles", body: "Listen, clarify, confirm.", surface: "dark" },
                  back: { type: "text", title: "Use them in order", body: "Hear the outcome, check what matters, then name the agreed next step.", surface: "neutral" },
                },
                { front: { type: "statement", eyebrow: "Key reminder", statement: "STOP", supportingText: "Check the customer need first.", surface: "warning" }, back: { type: "text", title: "Then choose the next useful action.", body: "A short pause prevents an answer that sounds certain but does not solve the right problem.", surface: "light" } },
              ]}
            />
            <FlipCards
              id="flip-visual-examples"
              revealMode="slide"
              heightMode="equal"
              format="portrait"
              cards={[
                {
                  front: { type: "image", image: flipCardPortraitImage, imageAlt: "A retail associate in a black apron reading an illustrated product reference sheet in front of stocked shelves.", label: "Image to text", title: "Prepare before the conversation", focalPosition: "center" },
                  back: { type: "text", title: "Acknowledge first", body: "Show the customer you understand the concern before moving to policy or process detail.", surface: "light" },
                },
                {
                  front: { type: "image-overlay", image: flipCardWideImage, imageAlt: "An unbranded skincare counter with products in the foreground and a staff member arranging a shelf in the background.", eyebrow: "Image Overlay", title: "Make the next step clear.", body: "Use a concise, confident opening.", overlayStyle: "dark", alignment: "left", verticalAlignment: "center" },
                  back: { type: "text", title: "Name the action and timing", body: "Close the conversation by confirming what will happen, who owns it and when progress can be checked.", surface: "neutral" },
                },
                {
                  front: { type: "text", eyebrow: "Text to image", title: "Notice the product presentation.", body: "A clear, ordered display makes it easier to guide a relevant conversation.", alignment: "left", surface: "secondary" },
                  back: { type: "image", image: flipCardDetailImage, imageAlt: "A hand selecting an unbranded clear skincare bottle from a neatly arranged shelf.", label: "Supporting visual", title: "Keep key products easy to find", focalPosition: "center" },
                },
              ]}
            />
            <FlipCards
              id="flip-image-to-image"
              revealMode="slide"
              heightMode="content"
              format="landscape"
              cards={[
                {
                  front: { type: "image", image: flipCardWideImage, imageAlt: "A wide view of an unbranded skincare counter and display shelves, with a staff member arranging products.", label: "Overview", title: "See the whole display", focalPosition: "right" },
                  back: { type: "image", image: flipCardDetailImage, imageAlt: "A close detail of a hand selecting an unbranded clear skincare bottle from a shelf.", label: "Detail", title: "Focus on the product choice", focalPosition: "center" },
                },
              ]}
            />
          </section>

          <section class="showcase-flip-card-section" aria-labelledby="flip-reveal-modes-heading">
            <h4 id="flip-reveal-modes-heading">Same card, different reveal</h4>
            <div class="showcase-flip-card-mode-grid">
              <FlipCards
                id="flip-mode-example"
                heading="Flip"
                revealMode="flip"
                heightMode="content"
                format="landscape"
                cards={revealModeComparisonCards}
              />
              <FlipCards
                id="slide-mode-example"
                heading="Slide"
                revealMode="slide"
                heightMode="content"
                format="landscape"
                cards={revealModeComparisonCards}
              />
            </div>
          </section>

          <section class="showcase-flip-card-section" aria-labelledby="flip-height-behaviour-heading">
            <h4 id="flip-height-behaviour-heading">Height and layout behaviour</h4>
            <FlipCards
              id="flip-equal-height-example"
              heading="Equal height card group"
              intro="A matched three-card set accounts for the tallest front or back face on wider layouts."
              revealMode="flip"
              heightMode="equal"
              format="square"
              cards={[
                { front: { type: "feature", value: "01", title: "Acknowledge", surface: "neutral", verticalAlignment: "center" }, back: { type: "text", title: "Name the concern", body: "Show the person that their situation has been understood.", surface: "light", verticalAlignment: "top" } },
                { front: { type: "feature", value: "02", title: "Clarify", surface: "accent", verticalAlignment: "center" }, back: { type: "text", title: "Ask one useful question", body: "Check the detail that changes the right next step.", surface: "light", verticalAlignment: "top" } },
                { front: { type: "statement", statement: "CORRECT", supportingText: "The customer need is clear.", surface: "success" }, back: { type: "text", title: "Confirm the next step", body: "Restate the action, owner and timing so progress can be checked.", surface: "light", verticalAlignment: "top" } },
              ]}
            />
          </section>

          <section class="showcase-flip-card-section" aria-labelledby="flip-content-resilience-heading">
            <h4 id="flip-content-resilience-heading">Content resilience</h4>
            <FlipCards
              id="flip-content-height-example"
              heading="Content height cards"
              intro="Independent cards keep their own stable height based on the larger of their two faces."
              revealMode="flip"
              heightMode="content"
              format="landscape"
              cards={[
                { front: { type: "text", title: "Short title", alignment: "center", verticalAlignment: "center", surface: "primary" }, back: { type: "text", title: "A concise explanation", body: "Use this mode when natural compact sizing matters more than matching a neighbouring card.", surface: "light", verticalAlignment: "top" } },
                { front: { type: "text", eyebrow: "Long heading", title: "A longer example still wraps naturally without reducing the text to an unreadably small size.", alignment: "left", verticalAlignment: "top", surface: "neutral" }, back: { type: "text", title: "Optional body stays optional", alignment: "center", verticalAlignment: "center", surface: "dark" } },
              ]}
            />
          </section>

          <section class="showcase-flip-card-section" aria-labelledby="flip-accessibility-heading">
            <h4 id="flip-accessibility-heading">Accessibility and guidance</h4>
            <p class="showcase-flip-card-accessibility">Every card is one keyboard-operable button with visible focus. The reveal keeps the outer card stable and respects reduced-motion preferences.</p>
          </section>
        </ShowcaseExample>}

        {visible("hotspot-reveal") && <ShowcaseExample id="hotspot-reveal" title="Click-to-Reveal Hotspots" purpose="Lets learners select marked image regions and read the associated detail." status={status("hotspot-reveal")}>
          <HotspotReveal
            id="workspace-hotspots"
            heading="Inspect the workspace setup"
            intro="Hotspots use real buttons and repeat the detail in text so the learning point is not only visual."
            imageSrc={neutralImage}
            imageAlt="A desk setup used as a neutral workspace inspection example."
            hotspots={[
              {
                label: "1",
                name: "Customer notes",
                x: 34,
                y: 44,
                title: "Keep notes visible",
                description: "Place the active customer notes where they can be checked before giving an update.",
              },
              {
                label: "2",
                name: "Reference checklist",
                x: 62,
                y: 37,
                title: "Use a short checklist",
                description: "A visible checklist helps the learner confirm the next step without searching through a long guide.",
              },
              {
                label: "3",
                name: "Clear workspace",
                x: 75,
                y: 68,
                title: "Remove distractions",
                description: "A clear workspace reduces the chance of mixing customer details or missing an important step.",
              },
            ]}
          />
          <ShowcaseNotes>
            <p>Use percentage positions so hotspots scale with the image. Provide a mobile list so precise pointer movement is never required.</p>
          </ShowcaseNotes>
        </ShowcaseExample>}

        {guidedProductExplorer && visible("guided-product-explorer") && <ProposalCard item={guidedProductExplorer} />}

        {visible("detail-modal") && <ShowcaseExample id="detail-modal" title="Supporting-Detail Modal or Panel" purpose="Opens optional supporting information without changing the main lesson flow." status={status("detail-modal")}>
          <DetailModal
            id="policy-detail-dialog"
            triggerLabel="Read the policy details"
            heading="Refund timing policy"
            content="Refunds should be explained as an expected processing window, not a guaranteed same-day outcome. Tell the customer what has been submitted, when it was submitted and where they can check the next update."
            imageSrc={neutralImage}
            imageAlt="A learner reviewing policy notes at a desk."
            action={{ href: "#accordion", label: "Review customer questions" }}
          />
          <ShowcaseNotes>
            <p>Use a modal for optional reference material. Do not hide essential instructions or assessment questions inside a modal.</p>
          </ShowcaseNotes>
        </ShowcaseExample>}
      </div>
    </ShowcaseSection>}

    {sectionVisible("navigate-related-content") && <ShowcaseSection id="navigate-related-content" title="Navigate related content" description="Patterns for switching between related panels, stages or small slide sets.">
      <div class="showcase-example-stack">
        {visible("tabs") && <ShowcaseExample id="tabs" title="Tabs" purpose="Switches between related content panels without leaving the section." status={status("tabs")}>
          <Tabs
            id="conversation-tabs"
            heading="Understand the conversation"
            intro="Use tabs for related peer content, not for steps that must be read in sequence."
            tabs={[
              { label: "Listen", icon: "hearing", content: "Let the customer finish the concern before offering a solution. Listen for the outcome they need, not only the problem they describe." },
              { label: "Clarify", icon: "help", content: "Ask one focused question to confirm the missing information. Avoid turning the conversation into an interrogation." },
              { label: "Explain", icon: "forum", content: "Use plain language and name the next step. Skip internal terminology unless the customer needs it." },
              { label: "Confirm", icon: "task_alt", content: "Close by confirming the action, owner and timing so the customer knows what will happen next." },
            ]}
          />
          <ShowcaseNotes>
            <p>Tabs support arrow, Home and End key navigation. Keep labels short enough to scan on mobile.</p>
          </ShowcaseNotes>
        </ShowcaseExample>}

        {visible("carousel") && <ShowcaseExample id="carousel" title="Carousel" purpose="Moves through a small set of related slides without autoplay." status={status("carousel")}>
          <PreviewOptions
            targetId="service-carousel"
            options={[
              {
                id: "indicator-style",
                label: "Indicator style",
                type: "select",
                value: "dots",
                targetAttribute: "carouselIndicatorStyle",
                options: [
                  { label: "Dots", value: "dots" },
                  { label: "Numbers", value: "numbers" },
                  { label: "None", value: "none" },
                ],
              },
              {
                id: "slide-content",
                label: "Slide content",
                type: "select",
                value: "image",
                targetAttribute: "carouselContent",
                options: [
                  { label: "Image", value: "image" },
                  { label: "Text", value: "text" },
                  { label: "Image + text", value: "image-text" },
                ],
              },
              {
                id: "arrow-position",
                label: "Arrow position",
                type: "segmented",
                value: "overlay",
                targetAttribute: "carouselArrowPosition",
                options: [
                  { label: "Overlay", value: "overlay" },
                  { label: "Outside", value: "outside" },
                ],
              },
              {
                id: "show-slide-count",
                label: "Show slide count",
                type: "toggle",
                value: true,
                targetAttribute: "carouselShowCount",
              },
            ]}
          />
          <Carousel
            id="service-carousel"
            heading="Three service moments"
            intro="Carousels are best for compact related examples. They should not hide long required procedures."
            contentType="image"
            slides={[
              {
                type: "image",
                image: neutralImage,
                imageAlt: "A learner reviewing notes before a customer conversation.",
                caption: "Preparation",
              },
              {
                type: "image",
                image: neutralImage,
                imageAlt: "A neutral workspace image used to demonstrate a second image slide.",
                caption: "Conversation",
              },
              {
                type: "image",
                image: neutralImage,
                imageAlt: "A neutral workspace image used to demonstrate a third image slide.",
                caption: "Follow-up",
              },
              {
                type: "text",
                title: "Listen first",
                body: "Let the customer describe the outcome they need before suggesting the next step.",
              },
              {
                type: "text",
                title: "Use plain language",
                body: "Choose the simplest accurate explanation and avoid internal process terms.",
              },
              {
                type: "text",
                title: "Close the loop",
                body: "Confirm the action, timing and where the customer can check progress.",
              },
              {
                type: "image-text",
                title: "Opening the conversation",
                body: "Start with the customer goal and acknowledge any urgency before asking for more detail.",
                image: neutralImage,
                imageAlt: "A learner reviewing notes for a customer conversation.",
                caption: "Moment 1",
              },
              {
                type: "image-text",
                title: "Explaining the option",
                body: "Connect the option to the customer's stated need and name any timing expectation.",
                image: neutralImage,
                imageAlt: "A neutral workspace image used for an explanation example.",
                caption: "Moment 2",
              },
              {
                type: "image-text",
                title: "Confirming the outcome",
                body: "Restate what will happen next and where the learner or customer can find the update.",
                image: neutralImage,
                imageAlt: "A neutral workspace image used for a confirmation example.",
                caption: "Moment 3",
              },
            ]}
          />
          <ShowcaseNotes>
            <p>The carousel does not autoplay. Previous and Next controls expose disabled states at the ends.</p>
          </ShowcaseNotes>
        </ShowcaseExample>}

        {visible("process-explorer") && <ShowcaseExample id="process-explorer" title="Process Explorer" purpose="Lets learners inspect one process step at a time without treating navigation as assessment progress." status={status("process-explorer")}>
          <ProcessExplorer
            id="customer-concern-process"
            heading="Responding to a customer concern"
            intro="Use this when a visible sequence needs richer detail than a static numbered process."
            steps={[
              { title: "Acknowledge", summary: "Name the concern.", detail: "Show the customer you understand the issue before moving to policy or process detail.", tip: "Use a short acknowledgement in your own words." },
              { title: "Clarify", summary: "Find the missing detail.", detail: "Ask for the one piece of information needed to choose the correct route.", warning: "Avoid asking questions already answered in the account notes." },
              { title: "Explain", summary: "Describe the path.", detail: "Give the next action and the reason for it in plain language." },
              { title: "Resolve", summary: "Take action.", detail: "Complete the action you can own, or hand over with clear context." },
              { title: "Confirm", summary: "Close the loop.", detail: "Restate the action, timing and where the customer can get an update." },
            ]}
          />
          <ShowcaseNotes>
            <p>Use the static Numbered Process layout when every step should stay visible at once.</p>
          </ShowcaseNotes>
        </ShowcaseExample>}

        {visible("timeline") && <ShowcaseExample id="timeline" title="Timeline" purpose="Lets learners select chronological milestones and read expanded detail." status={status("timeline")}>
          <Timeline
            id="order-journey-timeline"
            heading="A customer order journey"
            intro="Timeline markers are keyboard-operable buttons and the ordered list preserves the sequence."
            events={[
              { label: "Day 1", title: "Order placed", description: "The customer receives confirmation that the order has been captured.", detail: "At this point, avoid promising dispatch until payment and stock checks are complete." },
              { label: "Day 1", title: "Payment confirmed", description: "The payment clears and the order can move into preparation.", detail: "If payment is pending, explain the expected timing and where the customer can check status." },
              { label: "Day 2", title: "Order prepared", description: "The item is checked, packed and matched to the correct delivery details." },
              { label: "Day 3", title: "Order dispatched", description: "The customer receives tracking details or a delivery update." },
              { label: "Day 5", title: "Order delivered", description: "The customer receives the item and any follow-up guidance." },
            ]}
          />
          <ShowcaseNotes>
            <p>Do not rely on a connecting line to communicate sequence; the ordered list and labels carry the order.</p>
          </ShowcaseNotes>
        </ShowcaseExample>}
      </div>
    </ShowcaseSection>}

    {sectionVisible("explore-visual-content") && <ShowcaseSection id="explore-visual-content" title="Explore visual content" description="Patterns for inspecting images and diagrams.">
      <div class="showcase-example-stack">
        {visible("expandable-image") && <ShowcaseExample id="expandable-image" title="Expandable Image" purpose="Opens a larger image view for inspection using a native dialog." status={status("expandable-image")}>
          <ExpandableImage
            id="diagram-expanded-view"
            imageSrc={neutralImage}
            imageAlt="A detailed workspace diagram used as a neutral inspection example."
            caption="Small preview image. Open the modal when the learner needs a closer look."
            triggerLabel="View larger image"
            thumbnailSize="small"
          />
          <ShowcaseNotes>
            <p>Use this only when the inline image is a preview and the modal version is meaningfully larger. Supporting text belongs in a detail modal.</p>
          </ShowcaseNotes>
        </ShowcaseExample>}
      </div>
    </ShowcaseSection>}
  </div>
</ShowcaseLayout>
