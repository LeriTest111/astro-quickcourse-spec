---
import ShowcaseLayout from "../../layouts/ShowcaseLayout.astro";
import ShowcasePageHeader from "../../components/showcase/ShowcasePageHeader.astro";
import ShowcaseExample from "../../components/showcase/ShowcaseExample.astro";
import ShowcaseEmptyState from "../../components/showcase/ShowcaseEmptyState.astro";
import DetailModal from "../../components/interactions/display/DetailModal.astro";
import QuickCourseIcon from "../../components/ui/QuickCourseIcon.astro";
import { quickCourseIconTokens } from "../../data/quick-course-icons";
---

<ShowcaseLayout
  pageTitle="Icons | Astro Quick Course Showcase"
  description="Controlled Material Symbols Sharp icons for AI-generated Quick Courses."
  activeCategory="icons"
  showCourseFooter={false}
>
  <ShowcasePageHeader
    title="Icons"
    description="The Quick Course icon system uses a controlled semantic vocabulary and Material Symbols Sharp to produce consistent, accessible icons across AI-generated courses."
  />

  <div class="showcase-example-stack mt-8" data-showcase-collection>
    <ShowcaseEmptyState />

    <ShowcaseExample id="icon-set" title="Quick Course Icon System" purpose="One controlled standard for semantic meaning, sizing, colour and accessible use.">
      <div class="showcase-icon-information-controls">
        <DetailModal
          id="icon-usage-guidance"
          triggerLabel="Icon usage guidance"
          triggerIcon="information"
          triggerVariant="secondary"
          heading="Quick Course icon usage guidance"
        >
          <p>Use an icon only when it supports comprehension, navigation, action or status. Material Symbols Sharp is the Quick Course visual standard.</p>
          <ul class="di-dialog__list">
            <li>AI chooses a semantic token from the controlled vocabulary, never a raw icon-library name or visual family.</li>
            <li>Let parent components choose icon context and size where the placement is already known.</li>
            <li>Pair unfamiliar icons with visible text and prefer no icon over a weak match.</li>
            <li>Keep repeated visual support decorative. Icon-only buttons receive their accessible name from the parent button, while the nested SVG stays decorative to avoid duplicate announcements.</li>
            <li>Do not use icons or colour as the only indicator of an important status.</li>
            <li>Treatment is controlled by the component or state. AI must not choose emphasised or filled treatment for visual variety.</li>
            <li>Use <code>information</code> for neutral support and <code>tip</code> for advice. Use <code>person</code> for one individual, learner or customer; <code>team</code> for a group; and <code>manager</code> for a supervisor.</li>
            <li>Use <code>task</code> for one action or item to complete, <code>checklist</code> for several checks or steps, and <code>success</code> for completion or confirmation. Use <code>next</code> and <code>previous</code> for sequence navigation, and <code>expand</code> and <code>collapse</code> for content in the current location.</li>
            <li>When an icon-only button controls expandable content, update its accessible name, <code>aria-expanded</code> value and semantic icon to match the current state.</li>
          </ul>
        </DetailModal>

        <DetailModal
          id="icon-technical-implementation"
          triggerLabel="Technical implementation"
          triggerIcon="settings"
          triggerVariant="secondary"
          heading="Quick Course icon technical implementation"
        >
          <p><code>QuickCourseIcon</code> renders locally bundled Material Symbols Sharp SVG data from Iconify. The semantic type and central map live in <code>src/data/quick-course-icons.ts</code>; the reusable Astro component lives in <code>src/components/ui/QuickCourseIcon.astro</code>.</p>
          <ul class="di-dialog__list">
            <li>No runtime icon API request is required. Rendered SVG paths use <code>currentColor</code>, so known parent contexts control colour.</li>
            <li>TypeScript limits new use to controlled semantic tokens. Missing map entries and informative icons without labels fail clearly during development or build.</li>
            <li>Contexts control size: Inline, Button, Heading and Feature. The only filled SVG mapping is Success, where it represents a completed state.</li>
            <li>Static SVG output works in static and SCORM builds. The legacy remote Material Symbols font remains temporarily for older raw-ligature components that have not yet been migrated.</li>
            <li>Add a new token centrally after project-team review; do not expose unrestricted Iconify choices or add another visual family.</li>
          </ul>
        </DetailModal>
      </div>

      <section class="showcase-icon-system-section" aria-labelledby="icon-live-preview-heading">
        <div class="showcase-icon-system-section__header">
          <h4 id="icon-live-preview-heading">Contexts and placement</h4>
        </div>
        <div class="showcase-icon-context-grid">
          <div class="showcase-icon-context-demo">
            <p class="showcase-icon-context-label">Inline</p>
            <p class="qc-icon-label"><QuickCourseIcon name="information" context="inline" decorative /><span>Read the information before continuing.</span></p>
          </div>
          <div class="showcase-icon-context-demo">
            <p class="showcase-icon-context-label">Button</p>
            <button class="di-secondary-button" type="button"><span class="qc-icon-label"><QuickCourseIcon name="video" context="button" decorative /><span>Video guidance</span></span></button>
          </div>
          <div class="showcase-icon-context-demo">
            <p class="showcase-icon-context-label">Heading</p>
            <h5><span class="qc-icon-label qc-icon-label--heading"><QuickCourseIcon name="tip" context="heading" decorative /><span>Helpful tip</span></span></h5>
            <p class="showcase-icon-context-support">Use a short example to make the guidance easier to apply.</p>
          </div>
          <article class="showcase-icon-feature-demo">
            <p class="showcase-icon-context-label">Feature</p>
            <div class="showcase-icon-feature-demo__content"><QuickCourseIcon name="person" context="feature" decorative /><div><h5>Prepare for the customer conversation</h5><p>Use the learner's notes to guide a relevant next step.</p></div></div>
          </article>
        </div>
      </section>

      <section class="showcase-icon-system-section" aria-labelledby="icon-colour-heading">
        <div class="showcase-icon-system-section__header">
          <h4 id="icon-colour-heading">Controlled colour and emphasis</h4>
        </div>
        <h5 class="showcase-icon-subgroup-heading">Colour in context</h5>
        <div class="showcase-icon-colour-grid">
          <p class="qc-icon-label"><QuickCourseIcon name="information" context="inline" decorative /><span>Body text</span></p>
          <p class="showcase-icon-accent qc-icon-label"><QuickCourseIcon name="tip" context="inline" decorative /><span>Accent treatment</span></p>
          <p class="showcase-icon-status showcase-icon-status--success qc-icon-label"><QuickCourseIcon name="success" context="inline" decorative /><span>Success: changes saved</span></p>
          <p class="showcase-icon-status showcase-icon-status--warning qc-icon-label"><QuickCourseIcon name="warning" context="inline" decorative /><span>Warning: check the details</span></p>
          <p class="showcase-icon-status showcase-icon-status--error qc-icon-label"><QuickCourseIcon name="error" context="inline" decorative /><span>Error: try again</span></p>
        </div>
        <h5 class="showcase-icon-subgroup-heading">Visual treatment</h5>
        <div class="showcase-icon-treatment-grid" aria-label="Controlled visual emphasis treatments">
          <div><QuickCourseIcon name="success" context="heading" decorative /><strong>Default</strong><span>Normal guidance</span></div>
          <div class="showcase-icon-treatment--emphasised"><QuickCourseIcon name="success" context="heading" decorative /><strong>Emphasised</strong><span>Current guidance</span></div>
          <div class="showcase-icon-treatment--filled"><QuickCourseIcon name="success" context="heading" treatment="filled" decorative /><strong>Filled state</strong><span>Completed</span></div>
        </div>
      </section>

      <section class="showcase-icon-system-section" aria-labelledby="icon-tokens-heading">
        <div class="showcase-icon-system-section__header">
          <h4 id="icon-tokens-heading">Semantic icon tokens</h4>
        </div>
        <div class="showcase-icon-token-grid" aria-label="Current semantic icon vocabulary">
          {quickCourseIconTokens.map((icon) => (
            <div class="showcase-icon-token">
              <QuickCourseIcon name={icon.name} context="heading" decorative />
              <strong>{icon.name}</strong>
              <span>{icon.description}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="showcase-icon-system-section" id="icon-accessibility" aria-labelledby="icon-accessibility-heading">
        <div class="showcase-icon-system-section__header">
          <h4 id="icon-accessibility-heading">Accessibility</h4>
        </div>
        <div class="showcase-icon-accessibility-grid">
          <div>
            <p class="showcase-icon-demo-label">Decorative icon</p>
            <p class="qc-icon-label"><QuickCourseIcon name="video" context="inline" decorative /><span>Video guidance</span></p>
          </div>
          <div>
            <p class="showcase-icon-demo-label">Icon-only button</p>
            <button class="di-secondary-button di-icon-button showcase-icon-only-button" type="button" data-icon-demo-toggle aria-expanded="false" aria-controls="icon-demo-details" aria-label="Expand details"><span data-icon-demo-expand><QuickCourseIcon name="expand" context="button" decorative /></span><span data-icon-demo-collapse hidden><QuickCourseIcon name="collapse" context="button" decorative /></span></button>
            <div id="icon-demo-details" class="showcase-icon-demo-details" hidden>Details expanded.</div>
          </div>
        </div>
      </section>

      <script>
        document.querySelectorAll("[data-icon-demo-toggle]").forEach((button) => {
          if (!(button instanceof HTMLButtonElement) || button.dataset.iconDemoReady === "true") return;
          button.dataset.iconDemoReady = "true";
          const detailsId = button.getAttribute("aria-controls");
          const details = detailsId ? document.getElementById(detailsId) : null;
          if (!(details instanceof HTMLElement)) return;

          button.addEventListener("click", () => {
            const expanded = button.getAttribute("aria-expanded") !== "true";
            button.setAttribute("aria-expanded", String(expanded));
            button.setAttribute("aria-label", expanded ? "Collapse details" : "Expand details");
            details.hidden = !expanded;
            const expandIcon = button.querySelector("[data-icon-demo-expand]");
            const collapseIcon = button.querySelector("[data-icon-demo-collapse]");
            if (expandIcon instanceof HTMLElement) expandIcon.hidden = expanded;
            if (collapseIcon instanceof HTMLElement) collapseIcon.hidden = !expanded;
          });
        });
      </script>
    </ShowcaseExample>
  </div>
</ShowcaseLayout>
