---
interface NavItem {
  href: string;
  label: string;
}

interface Props {
  label?: string;
  items: NavItem[];
  activeHref?: string;
}

const { label = "Section navigation", items, activeHref } = Astro.props;
---

<nav class="qc-sticky-nav" aria-label={label} data-sticky-section-nav>
  <label class="qc-sticky-nav__select-label" for="sticky-section-nav-select">{label}</label>
  <select id="sticky-section-nav-select" class="qc-sticky-nav__select" data-sticky-section-select>
    {items.map((item) => <option value={item.href} selected={item.href === activeHref}>{item.label}</option>)}
  </select>
  <ul>
    {items.map((item) => (
      <li>
        <a href={item.href} class={item.href === activeHref ? "is-active" : ""}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  document.querySelectorAll("[data-sticky-section-nav]").forEach((nav) => {
    const select = nav.querySelector("[data-sticky-section-select]");

    if (select instanceof HTMLSelectElement) {
      select.addEventListener("change", () => {
        if (select.value) {
          window.location.hash = select.value;
        }
      });
    }

    const links = [...nav.querySelectorAll("a[href^='#']")];
    const sections = links
      .map((link) => document.querySelector(link.getAttribute("href") ?? ""))
      .filter(Boolean);

    if (!("IntersectionObserver" in window) || sections.length === 0) {
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (!visible) return;
        const href = `#${visible.target.id}`;
        links.forEach((link) => link.classList.toggle("is-active", link.getAttribute("href") === href));
        if (select instanceof HTMLSelectElement) {
          select.value = href;
        }
      },
      { rootMargin: "-25% 0px -60% 0px", threshold: 0.01 },
    );

    sections.forEach((section) => observer.observe(section));
  });
</script>
