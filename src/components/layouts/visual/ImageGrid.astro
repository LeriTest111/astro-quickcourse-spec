---
import type { HeadingLevel, LayoutImage } from "../layout-types";

interface Props {
  eyebrow?: string;
  heading?: string;
  intro?: string;
  headingLevel?: HeadingLevel;
  images: LayoutImage[];
  variant?: "two" | "three" | "four" | "featured";
}

const { eyebrow, heading, intro, headingLevel = 2, images, variant = "three" } = Astro.props;
const HeadingTag = `h${headingLevel}` as const;
const gridClass = {
  two: "md:grid-cols-2",
  three: "md:grid-cols-3",
  four: "md:grid-cols-2 xl:grid-cols-4",
  featured: "md:grid-cols-2",
}[variant];
---

<section class="qc-section">
  {
    heading && (
      <div class="qc-section-header">
        {eyebrow && <p class="qc-eyebrow">{eyebrow}</p>}
        <HeadingTag class="qc-section-title">{heading}</HeadingTag>
        {intro && <p class="qc-section-intro">{intro}</p>}
      </div>
    )
  }
  <div class={`qc-image-grid grid gap-4 ${gridClass}`}>
    {images.map((image, index) => (
      <figure class={variant === "featured" && index === 0 ? "md:row-span-2" : ""}>
        <img src={image.src} alt={image.alt} loading="lazy" />
        {image.caption && <figcaption>{image.caption}</figcaption>}
      </figure>
    ))}
  </div>
</section>

