---
import VideoPlayer from "./VideoPlayer.astro";

interface Action {
  label: string;
  href: string;
}

interface Props {
  id: string;
  heading: string;
  intro?: string;
  src: string;
  videoTitle?: string;
  poster?: string;
  caption?: string;
  points?: string[];
  action?: Action;
}

const { id, heading, intro, src, videoTitle, poster, caption, points = [], action } = Astro.props;
---

<section class="qc-video-with-text" aria-labelledby={`${id}-heading`}>
  <div class="qc-video-with-text__copy">
    <h3 id={`${id}-heading`}>{heading}</h3>
    {intro && <p>{intro}</p>}
    {points.length > 0 && (
      <ul>
        {points.map((point) => <li>{point}</li>)}
      </ul>
    )}
    {action && <a class="di-secondary-button" href={action.href}>{action.label}</a>}
  </div>
  <VideoPlayer id={`${id}-video`} src={src} title={videoTitle ?? heading} poster={poster} caption={caption} />
</section>
