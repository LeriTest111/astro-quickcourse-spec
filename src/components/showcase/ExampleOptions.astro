---
type OptionItem = {
  label: string;
  value: string;
};

type ExampleOption = {
  id: string;
  label: string;
  type: "select" | "segmented" | "toggle";
  value: string | boolean;
  targetAttribute: string;
  options?: OptionItem[];
};

interface Props {
  targetId: string;
  label?: string;
  options: ExampleOption[];
}

const { targetId, label = "Preview options", options } = Astro.props;
---

<form class="showcase-example-options" data-example-options data-example-options-target={targetId} aria-label={label}>
  {options.map((option) => (
    <div class="showcase-example-options__group" data-example-option-group>
      <span class="showcase-example-options__label">{option.label}</span>
      {option.type === "select" && (
        <label>
          <span class="sr-only">{option.label}</span>
          <select data-example-option={option.id} data-target-attribute={option.targetAttribute}>
            {option.options?.map((item) => (
              <option value={item.value} selected={item.value === option.value}>{item.label}</option>
            ))}
          </select>
        </label>
      )}
      {option.type === "segmented" && (
        <div class="showcase-example-options__segmented" role="radiogroup" aria-label={option.label}>
          {option.options?.map((item) => (
            <label>
              <input
                type="radio"
                name={`${targetId}-${option.id}`}
                value={item.value}
                data-example-option={option.id}
                data-target-attribute={option.targetAttribute}
                checked={item.value === option.value}
              />
              <span>{item.label}</span>
            </label>
          ))}
        </div>
      )}
      {option.type === "toggle" && (
        <label class="showcase-example-options__toggle">
          <input
            type="checkbox"
            data-example-option={option.id}
            data-target-attribute={option.targetAttribute}
            checked={Boolean(option.value)}
          />
          <span>{option.label}</span>
        </label>
      )}
    </div>
  ))}
</form>

<script>
  document.querySelectorAll("[data-example-options]").forEach((form) => {
    if (form.dataset.exampleOptionsReady === "true") return;
    form.dataset.exampleOptionsReady = "true";

    const targetId = form.dataset.exampleOptionsTarget;
    const target = targetId ? document.getElementById(targetId) : null;
    if (!target) return;

    function applyOptions() {
      form.querySelectorAll("[data-example-option]").forEach((control) => {
        const attribute = control.dataset.targetAttribute;
        if (!attribute) return;

        if (control instanceof HTMLInputElement && control.type === "radio" && !control.checked) return;

        const value = control instanceof HTMLInputElement && control.type === "checkbox"
          ? String(control.checked)
          : control instanceof HTMLInputElement || control instanceof HTMLSelectElement
            ? control.value
            : "";

        target.dataset[attribute] = value;
      });

      target.dispatchEvent(new CustomEvent("showcase-options-change"));
    }

    form.addEventListener("change", applyOptions);
    applyOptions();
  });
</script>
