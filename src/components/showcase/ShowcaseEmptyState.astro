---
import QuickCourseIcon from "../ui/QuickCourseIcon.astro";

interface Props {
  message?: string;
}

const { message = "No components in this category have been approved yet." } = Astro.props;
---

<div class="showcase-empty-state" data-showcase-empty-state role="status" hidden>
  <QuickCourseIcon name="document" context="heading" />
  <p>{message}</p>
</div>
