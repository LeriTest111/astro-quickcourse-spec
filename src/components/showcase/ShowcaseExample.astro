---
import StatusBadge from "./StatusBadge.astro";
import { getShowcaseItem } from "../../data/showcase-registry";
import type { ShowcaseStatus } from "../../data/showcase-registry";

interface Props {
  id: string;
  title: string;
  purpose: string;
  status?: ShowcaseStatus;
}

const { id, title, purpose, status } = Astro.props;
const registryItem = getShowcaseItem(id);
const displayStatus: ShowcaseStatus = registryItem ? registryItem.status : status ?? "in-review";
const replacement = registryItem?.replacementId ? getShowcaseItem(registryItem.replacementId) : undefined;
---

<article
  id={id}
  class="showcase-example scroll-mt-28"
  data-showcase-item
  data-showcase-status={displayStatus}
  aria-labelledby={`${id}-heading`}
>
      <div class="showcase-example__header">
        <div>
          <h3 id={`${id}-heading`} class="showcase-catalogue-section__item-heading">
            <a href={`#${id}`}>{title}</a>
          </h3>
          <p>{purpose}</p>
        </div>
        <StatusBadge status={displayStatus} />
      </div>
      {registryItem?.status === "deprecated" && (
        <div class="showcase-deprecated-note">
          <p>This component should not be used for new Quick Courses.</p>
          {registryItem.deprecatedReason && <p>{registryItem.deprecatedReason}</p>}
          {replacement && (
            <p>
              Use <a href={`#${replacement.id}`}>{replacement.name}</a> instead.
            </p>
          )}
        </div>
      )}
      <div class="showcase-example__preview">
        <slot />
      </div>
    </article>
