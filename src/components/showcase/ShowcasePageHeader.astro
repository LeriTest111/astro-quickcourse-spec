---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  count?: string;
}

const { eyebrow, title, description, count } = Astro.props;
---

<header class="showcase-page-header">
  {eyebrow && <p class="qc-eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  <p>{description}</p>
  {count && <span class="showcase-page-header__count">{count}</span>}
</header>
