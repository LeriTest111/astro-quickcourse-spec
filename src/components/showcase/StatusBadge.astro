---
import { formatShowcaseStatus, getShowcaseStatusTone } from "../../data/showcase-registry";
import type { ShowcaseStatus } from "../../data/showcase-registry";

interface Props {
  status?: ShowcaseStatus;
}

const { status = "in-review" } = Astro.props;
const label = formatShowcaseStatus(status);
const tone = getShowcaseStatusTone(status);
---

<span class="showcase-status" data-status={status} data-tone={tone}>{label}</span>
