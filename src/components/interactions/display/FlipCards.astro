---
interface FlipCard {
  frontHeading: string;
  frontText?: string;
  frontIcon?: string;
  frontImage?: string;
  frontImageAlt?: string;
  backHeading: string;
  backText: string;
}

interface Props {
  id: string;
  heading?: string;
  intro?: string;
  cards: FlipCard[];
  heightMode?: "equal" | "content";
}

const { id, heading, intro, cards, heightMode = "equal" } = Astro.props;
---

<section id={id} class="di-block" aria-labelledby={heading ? `${id}-heading` : undefined}>
  {
    heading && (
      <div class="di-block__header">
        <h3 id={`${id}-heading`}>{heading}</h3>
        {intro && <p>{intro}</p>}
      </div>
    )
  }
  <div id={`${id}-grid`} class={`di-flip-grid di-flip-grid--height-${heightMode}`} data-flip-grid data-flip-height-mode={heightMode}>
    {cards.map((card, index) => (
      <article class="di-flip-card" data-flip-card>
        <div class="di-flip-card__stage">
          <div class="di-flip-card__inner">
            <div class="di-flip-card__face di-flip-card__front" id={`${id}-front-${index}`} data-flip-face="front">
              {card.frontImage && <img src={card.frontImage} alt={card.frontImageAlt ?? ""} loading="lazy" />}
              {card.frontIcon && <span class="material-symbols-sharp showcase-icon" aria-hidden="true">{card.frontIcon}</span>}
              <h4>{card.frontHeading}</h4>
              {card.frontText && <p>{card.frontText}</p>}
            </div>
            <div class="di-flip-card__face di-flip-card__back" id={`${id}-back-${index}`} data-flip-face="back" aria-hidden="true">
              <h4>{card.backHeading}</h4>
              <p>{card.backText}</p>
            </div>
          </div>
        </div>
        <button
          type="button"
          class="di-secondary-button"
          aria-expanded="false"
          aria-controls={`${id}-back-${index}`}
          data-flip-toggle
        >
          Reveal detail
        </button>
      </article>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll("[data-flip-grid]").forEach((grid) => {
    if (grid.dataset.flipGridReady === "true") return;
    grid.dataset.flipGridReady = "true";

    const cards = [...grid.querySelectorAll("[data-flip-card]")];

    function measureCard(card) {
      const stage = card.querySelector(".di-flip-card__stage");
      const front = card.querySelector("[data-flip-face='front']");
      const back = card.querySelector("[data-flip-face='back']");
      if (!stage || !front || !back) return 0;
      return Math.max(front.scrollHeight, back.scrollHeight);
    }

    function updateHeights() {
      const mode = grid.dataset.flipHeightMode ?? "equal";
      const narrow = window.matchMedia("(max-width: 639px)").matches;
      const equalHeight = Math.max(...cards.map(measureCard));

      cards.forEach((card) => {
        const stage = card.querySelector(".di-flip-card__stage");
        const front = card.querySelector("[data-flip-face='front']");
        const back = card.querySelector("[data-flip-face='back']");
        if (!stage || !front || !back) return;

        const revealed = card.classList.contains("is-revealed");
        const activeFace = revealed ? back : front;
        const contentHeight = Math.max(activeFace.scrollHeight, 1);
        stage.style.setProperty("--flip-card-height", `${mode === "equal" && !narrow ? equalHeight : contentHeight}px`);
      });
    }

    cards.forEach((card) => {
      if (card.dataset.flipReady === "true") return;
      card.dataset.flipReady = "true";

      const button = card.querySelector("[data-flip-toggle]");
      const front = card.querySelector("[data-flip-face='front']");
      const back = card.querySelector("[data-flip-face='back']");

      button?.addEventListener("click", () => {
        const expanded = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", expanded ? "false" : "true");
        button.textContent = expanded ? "Reveal detail" : "Show prompt";
        card.classList.toggle("is-revealed", !expanded);
        front?.setAttribute("aria-hidden", expanded ? "false" : "true");
        back?.setAttribute("aria-hidden", expanded ? "true" : "false");
        updateHeights();
      });
    });

    grid.addEventListener("showcase-options-change", () => updateHeights());
    window.addEventListener("resize", updateHeights);
    updateHeights();
  });
</script>
