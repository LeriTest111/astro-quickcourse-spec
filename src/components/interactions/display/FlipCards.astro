---
import FlipCardFace from "./FlipCardFace.astro";
import QuickCourseIcon from "../../ui/QuickCourseIcon.astro";
import type { FlipCardFormat, FlipCardHeightMode, FlipCardItem, FlipCardRevealMode } from "./flip-card-types";

interface Props {
  id: string;
  heading?: string;
  intro?: string;
  cards: FlipCardItem[];
  revealMode?: FlipCardRevealMode;
  heightMode?: FlipCardHeightMode;
  format?: FlipCardFormat;
  class?: string;
}

const { id, heading, intro, cards, revealMode = "flip", heightMode = "equal", format = "square", class: className } = Astro.props;
const faceTitle = (face: FlipCardItem["front"]) => {
  const title = "title" in face ? face.title?.trim() : undefined;
  const label = "label" in face ? face.label?.trim() : undefined;
  return title || label || "card details";
};
---

<section id={id} class:list={["di-block", "di-flip-system", className]} aria-labelledby={heading ? `${id}-heading` : undefined}>
  {heading && (
    <div class="di-block__header">
      <h3 id={`${id}-heading`}>{heading}</h3>
      {intro && <p>{intro}</p>}
    </div>
  )}
  <div
    id={`${id}-grid`}
    class:list={["di-flip-grid", `di-flip-grid--height-${heightMode}`, `di-flip-grid--format-${format}`]}
    data-flip-grid
    data-flip-height-mode={heightMode}
    data-flip-reveal-mode={revealMode}
  >
    {cards.map((card, index) => {
      const frontTitle = faceTitle(card.front);
      const backTitle = faceTitle(card.back);
      const label = card.accessibleLabel?.trim() || frontTitle;
      return (
        <button
          type="button"
          class="di-flip-card"
          data-flip-card
          aria-pressed="false"
          aria-label={`Reveal ${backTitle} for ${label}`}
          aria-controls={`${id}-back-${index}`}
        >
          <span class="di-flip-card__stage">
            <span class="di-flip-card__inner">
              <span class="di-flip-card__face di-flip-card__front" id={`${id}-front-${index}`} data-flip-face="front">
                <FlipCardFace face={card.front} />
                <span class="di-flip-card__indicator" aria-hidden="true" data-flip-indicator="front"><QuickCourseIcon name="expand" context="inline" decorative /></span>
              </span>
              <span class="di-flip-card__face di-flip-card__back" id={`${id}-back-${index}`} data-flip-face="back" aria-hidden="true">
                <FlipCardFace face={card.back} />
                <span class="di-flip-card__indicator" aria-hidden="true" data-flip-indicator="back"><QuickCourseIcon name="collapse" context="inline" decorative /></span>
              </span>
            </span>
          </span>
        </button>
      );
    })}
  </div>
</section>

<script>
  document.querySelectorAll("[data-flip-grid]").forEach((grid) => {
    if (!(grid instanceof HTMLElement) || grid.dataset.flipGridReady === "true") return;
    grid.dataset.flipGridReady = "true";

    const cards = [...grid.querySelectorAll("[data-flip-card]")].filter((card): card is HTMLButtonElement => card instanceof HTMLButtonElement);
    const updateLabels = (card: HTMLButtonElement, revealed: boolean) => {
      const front = card.querySelector("[data-flip-face='front']");
      const back = card.querySelector("[data-flip-face='back']");
      const frontTitle = front?.querySelector(".di-flip-card__title, .di-flip-card__image-label strong")?.textContent?.trim() || "front";
      const backTitle = back?.querySelector(".di-flip-card__title, .di-flip-card__image-label strong")?.textContent?.trim() || "details";
      card.setAttribute("aria-label", revealed ? `Show ${frontTitle}` : `Reveal ${backTitle} for ${frontTitle}`);
    };

    const measureCard = (card: HTMLButtonElement) => {
      const stage = card.querySelector(".di-flip-card__stage");
      const front = card.querySelector("[data-flip-face='front']");
      const back = card.querySelector("[data-flip-face='back']");
      if (!(stage instanceof HTMLElement) || !(front instanceof HTMLElement) || !(back instanceof HTMLElement)) return 0;
      stage.style.removeProperty("--flip-card-height");
      return Math.max(stage.clientHeight, front.scrollHeight, back.scrollHeight);
    };

    const updateHeights = () => {
      const mode = grid.dataset.flipHeightMode ?? "equal";
      const useEqualHeight = mode === "equal" && !window.matchMedia("(max-width: 639px)").matches;
      const heights = cards.map(measureCard);
      const groupHeight = Math.max(...heights, 0);
      cards.forEach((card, index) => {
        const stage = card.querySelector(".di-flip-card__stage");
        if (stage instanceof HTMLElement) stage.style.setProperty("--flip-card-height", `${useEqualHeight ? groupHeight : heights[index]}px`);
      });
    };

    const scheduleHeightUpdate = () => window.requestAnimationFrame(updateHeights);
    cards.forEach((card) => {
      const front = card.querySelector("[data-flip-face='front']");
      const back = card.querySelector("[data-flip-face='back']");
      card.addEventListener("click", () => {
        const revealed = card.getAttribute("aria-pressed") !== "true";
        card.setAttribute("aria-pressed", String(revealed));
        card.classList.toggle("is-revealed", revealed);
        front?.setAttribute("aria-hidden", String(revealed));
        back?.setAttribute("aria-hidden", String(!revealed));
        updateLabels(card, revealed);
      });
      card.querySelectorAll("img").forEach((image) => image.addEventListener("load", scheduleHeightUpdate));
    });

    new ResizeObserver(scheduleHeightUpdate).observe(grid);
    window.addEventListener("resize", scheduleHeightUpdate);
    scheduleHeightUpdate();
  });
</script>
