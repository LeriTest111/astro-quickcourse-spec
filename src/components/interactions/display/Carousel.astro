---
type CarouselContentType = "image" | "text" | "image-text";
type IndicatorStyle = "dots" | "numbers" | "none";
type ArrowPosition = "overlay" | "outside";

interface CarouselSlide {
  type?: CarouselContentType;
  title?: string;
  body?: string;
  image?: string;
  imageAlt?: string;
  caption?: string;
  action?: {
    label: string;
    href: string;
  };
}

interface Props {
  id: string;
  heading?: string;
  intro?: string;
  slides: CarouselSlide[];
  contentType?: CarouselContentType;
  indicatorStyle?: IndicatorStyle;
  showSlideCount?: boolean;
  arrowPosition?: ArrowPosition;
}

const {
  id,
  heading,
  intro,
  slides,
  contentType,
  indicatorStyle = "dots",
  showSlideCount = true,
  arrowPosition = "overlay",
} = Astro.props;
---

<section
  id={id}
  class={`di-block di-carousel di-carousel--arrows-${arrowPosition}`}
  data-carousel
  data-carousel-content={contentType}
  data-carousel-indicator-style={indicatorStyle}
  data-carousel-show-count={showSlideCount ? "true" : "false"}
  data-carousel-arrow-position={arrowPosition}
  aria-labelledby={heading ? `${id}-heading` : undefined}
>
  {
    heading && (
      <div class="di-block__header">
        <h3 id={`${id}-heading`}>{heading}</h3>
        {intro && <p>{intro}</p>}
      </div>
    )
  }
  <div class="di-carousel__frame">
    <button class="di-carousel__arrow di-carousel__arrow--prev" type="button" aria-label="Previous slide" data-carousel-prev>
      <span class="material-symbols-sharp showcase-icon" aria-hidden="true">chevron_left</span>
    </button>
    <div class="di-carousel__viewport" aria-live="polite">
      {slides.map((slide, index) => (
        <article class={`di-carousel__slide di-carousel__slide--${slide.type ?? "image-text"}`} data-slide data-slide-group={slide.type ?? "image-text"} aria-label={`Slide ${index + 1} of ${slides.length}`}>
          {(slide.type ?? "image-text") === "image" && slide.image && (
            <figure>
              <img src={slide.image} alt={slide.imageAlt ?? ""} loading={index === 0 ? "eager" : "lazy"} />
              {slide.caption && <figcaption>{slide.caption}</figcaption>}
            </figure>
          )}
          {(slide.type ?? "image-text") === "text" && (
            <div class="di-carousel__text">
              {slide.title && <h4>{slide.title}</h4>}
              {slide.body && <p>{slide.body}</p>}
              {slide.action && <a class="di-secondary-button" href={slide.action.href}>{slide.action.label}</a>}
            </div>
          )}
          {(slide.type ?? "image-text") === "image-text" && (
            <>
              {slide.image && (
                <figure>
                  <img src={slide.image} alt={slide.imageAlt ?? ""} loading={index === 0 ? "eager" : "lazy"} />
                  {slide.caption && <figcaption>{slide.caption}</figcaption>}
                </figure>
              )}
              <div class="di-carousel__text">
                {slide.title && <h4>{slide.title}</h4>}
                {slide.body && <p>{slide.body}</p>}
                {slide.action && <a class="di-secondary-button" href={slide.action.href}>{slide.action.label}</a>}
              </div>
            </>
          )}
        </article>
      ))}
    </div>
    <button class="di-carousel__arrow di-carousel__arrow--next" type="button" aria-label="Next slide" data-carousel-next>
      <span class="material-symbols-sharp showcase-icon" aria-hidden="true">chevron_right</span>
    </button>
    <div class="di-carousel__controls" data-carousel-controls>
      <div class="di-carousel__dots" aria-label="Choose slide" data-carousel-indicators>
        {slides.map((slide, index) => (
          <button type="button" data-carousel-dot data-dot-group={slide.type ?? "image-text"} aria-label={`Show slide ${index + 1}${slide.title ? `: ${slide.title}` : ""}`}>
            <span class="sr-only">Slide </span><span data-dot-label>{index + 1}</span>
          </button>
        ))}
      </div>
      <p data-carousel-status>1 of {slides.length}</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-carousel]").forEach((carousel) => {
    if (carousel.dataset.carouselReady === "true") return;
    carousel.dataset.carouselReady = "true";

    const slides = [...carousel.querySelectorAll("[data-slide]")];
    const previous = carousel.querySelector("[data-carousel-prev]");
    const next = carousel.querySelector("[data-carousel-next]");
    const dots = [...carousel.querySelectorAll("[data-carousel-dot]")];
    const status = carousel.querySelector("[data-carousel-status]");
    const indicators = carousel.querySelector("[data-carousel-indicators]");
    let current = 0;

    function getVisibleSlides() {
      const contentFilter = carousel.dataset.carouselContent;
      return slides.filter((slide) => !contentFilter || slide.dataset.slideGroup === contentFilter);
    }

    function render() {
      const indicatorStyle = carousel.dataset.carouselIndicatorStyle ?? "dots";
      const showCount = carousel.dataset.carouselShowCount !== "false";
      const arrowPosition = carousel.dataset.carouselArrowPosition ?? "overlay";
      carousel.classList.toggle("di-carousel--arrows-overlay", arrowPosition === "overlay");
      carousel.classList.toggle("di-carousel--arrows-outside", arrowPosition === "outside");

      const visibleSlides = getVisibleSlides();
      if (current > visibleSlides.length - 1) current = Math.max(0, visibleSlides.length - 1);

      slides.forEach((slide, index) => {
        const visibleIndex = visibleSlides.indexOf(slide);
        const isActive = visibleIndex === current;
        const isInSet = visibleIndex !== -1;
        slide.hidden = !isInSet || !isActive;
        slide.toggleAttribute("inert", !isInSet || !isActive);
        slide.classList.toggle("is-active", isActive);
      });
      let visibleDotIndex = 0;
      dots.forEach((dot, index) => {
        const slide = slides[index];
        const isInSet = visibleSlides.includes(slide);
        dot.hidden = !isInSet || indicatorStyle === "none";
        if (!isInSet) return;
        dot.classList.toggle("is-numbered", indicatorStyle === "numbers");
        dot.querySelector("[data-dot-label]").textContent = indicatorStyle === "numbers" ? `${visibleDotIndex + 1}` : "";
        dot.setAttribute("aria-current", visibleDotIndex === current ? "true" : "false");
        visibleDotIndex += 1;
      });
      if (indicators) indicators.hidden = indicatorStyle === "none";
      if (previous) previous.disabled = current === 0;
      if (next) next.disabled = current === visibleSlides.length - 1;
      if (status) {
        status.hidden = !showCount;
        status.textContent = `${current + 1} of ${visibleSlides.length}`;
      }
    }

    previous?.addEventListener("click", () => {
      current = Math.max(0, current - 1);
      render();
    });

    next?.addEventListener("click", () => {
      current = Math.min(getVisibleSlides().length - 1, current + 1);
      render();
    });

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        const slide = slides[index];
        current = getVisibleSlides().indexOf(slide);
        render();
      });
    });

    carousel.addEventListener("showcase-options-change", () => {
      current = 0;
      render();
    });

    render();
  });
</script>
