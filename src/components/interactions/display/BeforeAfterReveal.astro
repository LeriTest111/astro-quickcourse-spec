---
interface Props {
  id: string;
  heading?: string;
  intro?: string;
  beforeImage: string;
  beforeAlt: string;
  afterImage: string;
  afterAlt: string;
  beforeLabel?: string;
  afterLabel?: string;
  caption?: string;
}

const {
  id,
  heading,
  intro,
  beforeImage,
  beforeAlt,
  afterImage,
  afterAlt,
  beforeLabel = "Before",
  afterLabel = "After",
  caption,
} = Astro.props;
---

<section class="di-block di-before-after" data-before-after aria-labelledby={heading ? `${id}-heading` : undefined}>
  {
    heading && (
      <div class="di-block__header">
        <h3 id={`${id}-heading`}>{heading}</h3>
        {intro && <p>{intro}</p>}
      </div>
    )
  }
  <figure>
    <div class="di-before-after__compare" style="--reveal: 50%;">
      <img src={beforeImage} alt={beforeAlt} loading="lazy" />
      <div class="di-before-after__after">
        <img src={afterImage} alt={afterAlt} loading="lazy" />
      </div>
      <span class="di-before-after__label di-before-after__label--before">{beforeLabel}</span>
      <span class="di-before-after__label di-before-after__label--after">{afterLabel}</span>
    </div>
    <div class="di-before-after__fallback">
      <div><img src={beforeImage} alt={beforeAlt} loading="lazy" /><p>{beforeLabel}</p></div>
      <div><img src={afterImage} alt={afterAlt} loading="lazy" /><p>{afterLabel}</p></div>
    </div>
    <label class="di-before-after__control" for={`${id}-range`}>
      Reveal {afterLabel.toLowerCase()} view
      <input id={`${id}-range`} type="range" min="0" max="100" value="50" data-before-after-range />
    </label>
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
</section>

<script>
  document.querySelectorAll("[data-before-after]").forEach((root) => {
    if (root.dataset.beforeAfterReady === "true") return;
    root.dataset.beforeAfterReady = "true";
    root.classList.add("is-enhanced");

    const compare = root.querySelector(".di-before-after__compare");
    const range = root.querySelector("[data-before-after-range]");

    range?.addEventListener("input", () => {
      compare?.style.setProperty("--reveal", `${range.value}%`);
    });
  });
</script>

