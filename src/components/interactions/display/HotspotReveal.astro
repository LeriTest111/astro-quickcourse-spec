---
interface Hotspot {
  label: string;
  name: string;
  x: number;
  y: number;
  title: string;
  description: string;
}

interface Props {
  id: string;
  heading?: string;
  intro?: string;
  imageSrc: string;
  imageAlt: string;
  hotspots: Hotspot[];
}

const { id, heading, intro, imageSrc, imageAlt, hotspots } = Astro.props;
---

<section class="di-block di-hotspots" data-hotspots aria-labelledby={heading ? `${id}-heading` : undefined}>
  {
    heading && (
      <div class="di-block__header">
        <h3 id={`${id}-heading`}>{heading}</h3>
        {intro && <p>{intro}</p>}
      </div>
    )
  }
  <div class="di-hotspots__layout">
    <div class="di-hotspots__image-wrap">
      <img src={imageSrc} alt={imageAlt} loading="lazy" />
      {hotspots.map((hotspot, index) => (
        <button
          type="button"
          class="di-hotspot"
          style={`--x: ${hotspot.x}%; --y: ${hotspot.y}%`}
          aria-pressed={index === 0 ? "true" : "false"}
          aria-controls={`${id}-hotspot-${index}`}
          data-hotspot-index={index}
          data-hotspot-button
        >
          <span aria-hidden="true">{hotspot.label}</span>
          <span class="sr-only">{hotspot.name}</span>
        </button>
      ))}
    </div>
    <div class="di-hotspots__details">
      <ol class="di-hotspots__text-controls" aria-label="Hotspot details">
        {hotspots.map((hotspot, index) => (
          <li>
            <button
              type="button"
              aria-pressed={index === 0 ? "true" : "false"}
              aria-controls={`${id}-hotspot-${index}`}
              data-hotspot-index={index}
              data-hotspot-button
            >
              <span>{hotspot.label}</span>
              <strong>{hotspot.name}</strong>
            </button>
          </li>
        ))}
      </ol>
      <div class="di-hotspots__panels">
        {hotspots.map((hotspot, index) => (
          <article id={`${id}-hotspot-${index}`} data-hotspot-panel>
            <p class="di-kicker">{hotspot.label}</p>
            <h4>{hotspot.title}</h4>
            <p>{hotspot.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-hotspots]").forEach((root) => {
    if (root.dataset.hotspotsReady === "true") return;
    root.dataset.hotspotsReady = "true";

    const buttons = [...root.querySelectorAll("[data-hotspot-button]")];
    const panels = [...root.querySelectorAll("[data-hotspot-panel]")];

    function activate(index) {
      buttons.forEach((button) => {
        button.setAttribute("aria-pressed", Number(button.dataset.hotspotIndex) === index ? "true" : "false");
      });
      panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== index;
      });
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => activate(Number(button.dataset.hotspotIndex ?? 0)));
    });

    activate(0);
  });
</script>
