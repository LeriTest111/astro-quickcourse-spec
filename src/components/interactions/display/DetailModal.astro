---
import type { LayoutAction } from "../../layouts/layout-types";
import QuickCourseIcon from "../../ui/QuickCourseIcon.astro";
import type { QuickCourseIconName } from "../../../data/quick-course-icons";

interface Props {
  id: string;
  triggerLabel: string;
  triggerIcon?: QuickCourseIconName;
  triggerIconOnly?: boolean;
  triggerVariant?: "primary" | "secondary";
  heading: string;
  content?: string;
  imageSrc?: string;
  imageAlt?: string;
  action?: LayoutAction;
}

const { id, triggerLabel, triggerIcon, triggerIconOnly = false, triggerVariant = "primary", heading, content, imageSrc, imageAlt = "", action } = Astro.props;
const triggerClass = triggerVariant === "secondary" ? "di-secondary-button" : "di-primary-button";
const triggerClasses = [triggerClass, triggerIconOnly && "di-icon-button"].filter(Boolean).join(" ");
---

<div class="di-detail-modal" data-detail-modal>
  <button class={triggerClasses} type="button" data-detail-open aria-label={triggerIconOnly ? triggerLabel : undefined}>
    {triggerIcon ? (
      <span class:list={["qc-icon-label", triggerIconOnly && "qc-icon-label--icon-only"]}>
        <QuickCourseIcon name={triggerIcon} context="button" decorative />
        {!triggerIconOnly && <span>{triggerLabel}</span>}
      </span>
    ) : !triggerIconOnly && <span>{triggerLabel}</span>}
  </button>
  <dialog class="di-dialog" id={id} aria-labelledby={`${id}-heading`} data-detail-dialog>
    <div class="di-dialog__inner">
      <button class="di-dialog__close" type="button" data-dialog-close aria-label="Close detail panel">
        <QuickCourseIcon name="close" context="button" decorative />
      </button>
      {imageSrc && <img src={imageSrc} alt={imageAlt} loading="lazy" />}
      <h3 id={`${id}-heading`}>{heading}</h3>
      {content && <p>{content}</p>}
      <slot />
      {action && <a class="di-secondary-button" href={action.href}>{action.label}</a>}
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll("[data-detail-modal]").forEach((root) => {
    if (root.dataset.detailModalReady === "true") return;
    root.dataset.detailModalReady = "true";

    const openButton = root.querySelector("[data-detail-open]");
    const dialog = root.querySelector("[data-detail-dialog]");
    const closeButton = root.querySelector("[data-dialog-close]");

    openButton?.addEventListener("click", () => {
      if (dialog instanceof HTMLDialogElement) {
        dialog.showModal();
        closeButton?.focus();
      }
    });

    closeButton?.addEventListener("click", () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });

    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
    });

    dialog?.addEventListener("close", () => openButton?.focus());
  });
</script>
