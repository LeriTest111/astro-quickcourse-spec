---
interface Props {
  id: string;
  imageSrc?: string;
  fullImageSrc?: string;
  imageAlt?: string;
  alt?: string;
  thumbnailSrc?: string;
  caption?: string;
  expandLabel?: string;
  triggerLabel?: string;
  thumbnailSize?: "small" | "medium";
}

const {
  id,
  imageSrc,
  fullImageSrc,
  imageAlt,
  alt,
  thumbnailSrc,
  caption,
  expandLabel = "View larger image",
  triggerLabel,
  thumbnailSize = "medium",
} = Astro.props;

const resolvedImageSrc = fullImageSrc ?? imageSrc ?? "";
const resolvedAlt = alt ?? imageAlt ?? "";
const resolvedLabel = triggerLabel ?? expandLabel;
---

<figure class={`di-expandable-image di-expandable-image--${thumbnailSize}`} data-expandable-image>
  <div class="di-expandable-image__thumb">
    <img src={thumbnailSrc ?? resolvedImageSrc} alt={resolvedAlt} loading="lazy" />
    <button class="di-expandable-image__open" type="button" data-expand-image-open>
      <span class="material-symbols-sharp showcase-icon" aria-hidden="true">open_in_full</span>
      <span>{resolvedLabel}</span>
    </button>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
  <dialog class="di-dialog di-dialog--image" id={id} aria-label={resolvedLabel} data-expand-image-dialog>
    <button class="di-dialog__close di-dialog__close--overlay" type="button" data-dialog-close aria-label="Close expanded image">
      <span class="material-symbols-sharp showcase-icon" aria-hidden="true">close</span>
    </button>
    <img src={resolvedImageSrc} alt={resolvedAlt} loading="lazy" />
  </dialog>
</figure>

<script>
  document.querySelectorAll("[data-expandable-image]").forEach((root) => {
    if (root.dataset.expandableReady === "true") return;
    root.dataset.expandableReady = "true";

    const openButton = root.querySelector("[data-expand-image-open]");
    const dialog = root.querySelector("[data-expand-image-dialog]");
    const closeButton = root.querySelector("[data-dialog-close]");

    openButton?.addEventListener("click", () => {
      if (dialog instanceof HTMLDialogElement) {
        dialog.showModal();
        closeButton?.focus();
      }
    });

    closeButton?.addEventListener("click", () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });

    dialog?.addEventListener("close", () => openButton?.focus());
  });
</script>
