---
import ChoiceQuestion from "./ChoiceQuestion.astro";

const {
  id = "multiple-choice-feedback",
  eyebrow = "Knowledge check",
  title = "Multiple-choice feedback",
  prompt,
  instruction = "Choose one option to see feedback.",
  options = [],
} = Astro.props;
---

<ChoiceQuestion
  id={id}
  eyebrow={eyebrow}
  title={title}
  prompt={prompt}
  instruction={instruction}
  selectionMode="single"
  submissionMode="instant"
  options={options.map((option, index) => ({
    id: option.id ?? `option-${index + 1}`,
    label: option.text,
    isCorrect: option.isCorrect,
    feedback: option.feedback,
  }))}
/>
