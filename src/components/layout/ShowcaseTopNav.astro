---
import { showcaseCategories } from "../../data/showcase";
import ShowcaseViewSelector from "../showcase/ShowcaseViewSelector.astro";

interface Props {
  activeCategory?: string;
}

const { activeCategory = "home" } = Astro.props;
const shortNavLabels: Record<string, string> = {
  "display-interactions": "Interactions",
  "assessment-interactions": "Assessments",
};
const navItems = [{ label: "Home", href: "/", slug: "home" }, ...showcaseCategories].map((item) => ({
  ...item,
  label: shortNavLabels[item.slug] ?? item.label,
}));
---

<header class="showcase-topbar sticky top-3 z-30 mx-auto max-w-7xl">
  <div class="showcase-topbar__inner">
    <a class="showcase-brand" href="/" aria-label="Quick Course Kit home" data-showcase-view-link>
      <span class="showcase-logo-badge" aria-hidden="true">
        <span>QC</span>
      </span>
      <span class="showcase-brand__title">Quick Course Kit</span>
    </a>

    <nav class="showcase-topbar__nav" aria-label="Showcase navigation">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} data-showcase-view-link aria-current={item.slug === activeCategory ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <ShowcaseViewSelector class="showcase-view-selector--desktop" />

    <details class="showcase-topbar__mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Showcase mobile navigation">
        <ul>
          {navItems.map((item) => (
            <li>
              <a href={item.href} data-showcase-view-link aria-current={item.slug === activeCategory ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <ShowcaseViewSelector class="showcase-view-selector--mobile" />
      </nav>
    </details>
  </div>
</header>
