---
import PreviewOptions from "../../showcase/PreviewOptions.astro";

type DisplayOption = {
  id?: string;
  label: string;
  type?: "select" | "segmented" | "toggle";
  value?: string | boolean;
  part?: "eyebrow" | "summary" | "primary-action" | "secondary-action";
  targetAttribute?: string;
  options?: { label: string; value: string }[];
};

interface Props {
  previewId: string;
  options: DisplayOption[];
}

const { previewId, options } = Astro.props;
---

<PreviewOptions
  targetId={`hero-preview-${previewId}`}
  targetSelector={`[data-hero-preview="${previewId}"]`}
  options={options.map((option) => {
    const type = option.type ?? "toggle";

    return {
      id: option.id ?? option.part ?? option.label.toLowerCase().replaceAll(" ", "-"),
      label: option.label,
      type,
      value: option.value ?? true,
      targetAttribute: option.targetAttribute,
      targetPart: option.part,
      options: option.options,
    };
  })}
/>
