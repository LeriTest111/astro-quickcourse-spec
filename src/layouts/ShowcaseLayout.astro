---
import "../styles/showcase.css";
import ShowcaseTopNav from "../components/layout/ShowcaseTopNav.astro";
import CourseFooter from "../components/course/footer/CourseFooter.astro";
import QuickCourseIcon from "../components/ui/QuickCourseIcon.astro";

const {
  pageTitle = "Astro Quick Course Showcase",
  description = "A neutral visual reference for reusable Astro course components.",
  activeCategory = "home",
  showCourseFooter = true,
  loadMaterialSymbols = true,
} = Astro.props;

---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      {`(() => {
        const requestedView = new URLSearchParams(window.location.search).get("view");
        let storedView = null;
        try {
          storedView = window.localStorage.getItem("quick-course-kit-view");
        } catch {
          // The page still defaults cleanly when browser storage is unavailable.
        }
        const view = requestedView === "approved" || requestedView === "development"
          ? requestedView
          : storedView === "approved" || storedView === "development"
            ? storedView
            : "development";
        document.documentElement.dataset.showcaseView = view;
      })();`}
    </script>
    {loadMaterialSymbols && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Sharp:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
          rel="stylesheet"
        />
      </>
    )}
    <title>{pageTitle}</title>
  </head>
  <body id="page-top">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="min-h-screen">
      <div class="px-3 pt-3 md:px-6 md:pt-6">
        <ShowcaseTopNav activeCategory={activeCategory} />
      </div>

      <main id="main-content" class="mx-auto max-w-7xl px-4 py-8">
        <slot />
      </main>

      {showCourseFooter && <div class="mx-auto max-w-7xl px-4 pb-8"><CourseFooter /></div>}
    </div>

    <script>
      import "../scripts/showcase-view";
    </script>

    <a class="back-to-top" href="#page-top" aria-label="Back to top" title="Back to top">
      {loadMaterialSymbols ? (
        <span class="material-symbols-sharp showcase-icon" aria-hidden="true">arrow_upward</span>
      ) : (
        <QuickCourseIcon name="collapse" context="button" />
      )}
    </a>
  </body>
</html>
