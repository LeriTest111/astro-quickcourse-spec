---
import "../styles/global.css";
import ShowcaseTopNav from "../components/layout/ShowcaseTopNav.astro";
import CourseFooter from "../components/course/footer/CourseFooter.astro";
import { showcaseMode, showcaseModeIdentity } from "../data/showcase-registry";

const {
  pageTitle = "Astro Quick Course Showcase",
  description = "A neutral visual reference for reusable Astro course components.",
  activeCategory = "home",
} = Astro.props;

const modeIdentity = showcaseModeIdentity[showcaseMode];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Sharp:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body id="page-top">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="min-h-screen">
      <div class="px-3 pt-3 md:px-6 md:pt-6">
        <ShowcaseTopNav activeCategory={activeCategory} />
      </div>

      <main id="main-content" class="mx-auto max-w-7xl px-4 py-8">
        <aside class="showcase-mode-banner" aria-label="Showcase build mode">
          <div>
            <p>{modeIdentity.title}</p>
            <span>{modeIdentity.description}</span>
          </div>
        </aside>
        <slot />
      </main>

      <div class="mx-auto max-w-7xl px-4 pb-8">
        <CourseFooter />
      </div>
    </div>

    <a class="back-to-top" href="#page-top" aria-label="Back to top" title="Back to top">
      <span class="material-symbols-sharp showcase-icon" aria-hidden="true">arrow_upward</span>
    </a>
  </body>
</html>
